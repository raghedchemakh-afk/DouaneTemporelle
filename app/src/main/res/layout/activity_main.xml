<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_main_rc"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#EAF4F8">

    <LinearLayout
        android:id="@+id/layout_main_rc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:background="#FFFFFF"
        android:layout_margin="16dp">

        <!-- 1: عنوان الاستمارة -->
        <TextView
            android:id="@+id/txt_titre_rc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DOUANE TEMPORELLE"
            android:textSize="25sp"
            android:textStyle="bold"
            android:textColor="#173B57"
            android:gravity="center"
            android:padding="20dp" />

        <!-- 2: اسم المسافر -->
        <TextView
            android:id="@+id/txt_nom_rc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nom du voyageur"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#263B50"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/edt_nom_rc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Entrez votre nom"
            android:inputType="textCapWords"
            android:minHeight="52dp"
            android:padding="12dp"
            android:backgroundTint="#008C95"
            android:textColor="#263B50" />

        <!-- 3: سنة الميلاد -->
        <TextView
            android:id="@+id/txt_naissance_rc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Année de naissance"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#263B50"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/edt_naissance_rc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Exemple : 2000"
            android:inputType="number"
            android:maxLength="4"
            android:minHeight="52dp"
            android:padding="12dp"
            android:backgroundTint="#008C95"
            android:textColor="#263B50" />

        <!-- 4: سنة الوجهة -->
        <TextView
            android:id="@+id/txt_destination_rc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Année de destination"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#263B50"
            android:layout_marginTop="20dp" />

        <EditText
            android:id="@+id/edt_destination_rc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Exemple : 2050"
            android:inputType="number"
            android:maxLength="4"
            android:minHeight="52dp"
            android:padding="12dp"
            android:backgroundTint="#008C95"
            android:textColor="#263B50" />

        <!-- 5: سبب السفر -->
        <TextView
            android:id="@+id/txt_motif_rc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Motif du voyage"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#263B50"
            android:layout_marginTop="20dp" />

        <Spinner
            android:id="@+id/spn_motif_rc"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:backgroundTint="#008C95" />

        <!-- 6: زر فحص الملف -->
        <Button
            android:id="@+id/btn_inspecter_rc"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Inspecter le profil"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="16sp"
            android:backgroundTint="#008C95"
            android:layout_marginTop="32dp" />

    </LinearLayout>

</ScrollView>