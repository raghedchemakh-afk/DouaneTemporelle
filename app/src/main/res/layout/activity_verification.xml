<?xml version="1.0" encoding="utf-8"?>

<!-- 1: الواجهة الرئيسية الأفقية -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="#FFFFFF">

    <!-- 2: صورة جواز السفر على اليسار بنسبة 0.3 -->
    <ImageView
        android:id="@+id/img_passeport_rc"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.3"
        android:src="@android:drawable/ic_menu_gallery"
        android:scaleType="centerInside"
        android:contentDescription="صورة جواز السفر" />

    <!-- 3: معلومات المسافر على اليمين بنسبة 0.7 -->
    <RelativeLayout
        android:id="@+id/layout_verification_rc"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.7"
        android:padding="16dp">

        <!-- 4: عنوان واجهة التحقق -->
        <TextView
            android:id="@+id/txt_titre_verification_rc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DOUANE TEMPORELLE"
            android:textSize="23sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- 5: اسم المسافر -->
        <TextView
            android:id="@+id/txt_nom_voyageur_rc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_titre_verification_rc"
            android:layout_marginTop="35dp"
            android:text="Nom du voyageur :"
            android:textSize="18sp" />

        <!-- 6: العمر الزمني للمسافر -->
        <TextView
            android:id="@+id/txt_age_temporel_rc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_nom_voyageur_rc"
            android:layout_marginTop="20dp"
            android:text="Âge temporel :"
            android:textSize="18sp" />

        <!-- 7: سبب الرحلة -->
        <TextView
            android:id="@+id/txt_motif_voyage_rc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_age_temporel_rc"
            android:layout_marginTop="20dp"
            android:text="Motif du voyage :"
            android:textSize="18sp" />

        <!-- 8: زر الموافقة على الرحلة -->
        <Button
            android:id="@+id/btn_accepter_rc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@id/btn_refuser_rc"
            android:text="Approuver le saut temporel" />

        <!-- 9: زر رفض الرحلة -->
        <Button
            android:id="@+id/btn_refuser_rc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:text="Refuser (Risque de paradoxe)" />

    </RelativeLayout>

</LinearLayout>